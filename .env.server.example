# Copy to .env.server. Never commit the real file.
# Existing PostgreSQL database; use a host reachable FROM the container.
# Same Docker network: use the PostgreSQL service name and its internal port.
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/trendmanga

STORAGE_BACKEND=r2
R2_BUCKET=manga
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_PUBLIC_BASE_URL=https://cdn.trendmanga.com
R2_RAW_PREFIX=raw
R2_TRANSLATED_PREFIX=translated
R2_KEEP_WORKDIR=false

# 9router must be reachable from the server. 127.0.0.1 is this container itself!
# Same Docker network: http://9router:20128/v1
# On the server host: http://host.docker.internal:20128/v1 (host-gateway is in compose).
# Host 9router must listen on an interface reachable by Docker, not just loopback.
OPENAI_BASE_URL=http://9router:20128/v1
OPENAI_API_KEY=YOUR_9ROUTER_API_KEY
# Direct model. To use a configured combo, replace this with its exact name.
OPENAI_MODEL=cx/gpt-6-luna

# Optional site cache invalidation: must match the web application's secret.
WEB_INTERNAL_URL=https://trendmanga.com
INTERNAL_API_KEY=YOUR_WEB_INTERNAL_API_KEY

# CPU server: one chapter job at a time, limited local parallelism.
USE_GPU=false
SEG_DEVICE=cpu
LAMA_DEVICE=cpu
USE_TENSORRT=false
BATCH_WORKERS=1
BATCH_WORKERS_AUTO=false
BATCH_WORKERS_MAX=1
BATCH_TRANSLATE_CONCURRENCY=1
OCR_CONCURRENCY=1
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
TRANSLATION_CPUS=2.0
TRANSLATION_MEMORY=8g
# Existing network containing 9router / PostgreSQL; create it if needed.
WORKER_DOCKER_NETWORK=trendmanga
WORKER_IDLE_SECONDS=15
# Longer allowance for first model downloads and slow CPU operations.
TRANSLATION_STALL_SECONDS=1800
# Leave unset: Docker hostname provides a unique ID, unlike the PC's translator ID.
# WORKER_INSTANCE_ID=translator-server-1

SOURCE_LANG=English
TARGET_LANG=Turkish
DETECTOR=RT-DETR-v4-s-int8
OCR=9Router Vision Grid OCR
TRANSLATOR=GPT-5.4-mini
WEBTOON_SAFE_RECUT=true
RECUT_TARGET_HEIGHT=2000
RECUT_MAX_HEIGHT=8000
FONT_FILE=assets/Comic Geek.ttf
FONT_FAMILY=Comic Geek
MIN_FONT_SIZE=14
MAX_FONT_SIZE=58
OUTPUT_FORMAT=webp
IMAGE_QUALITY=95
SEO_SITE_NAME=TrendManga
SEO_LANGUAGE_PHRASE=Türkçe manga oku
STAMP_ENABLED=true
STAMP_PATH=assets/brand-stamp.png
STAMP_EVERY_PAGES=5
AD_VISION_ENABLED=true
OCR_MAX_FAIL_RATIO=0.0
