# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Secrets - never commit real env values
.env
.env.local

# Virtual environments
.venv/
venv/
env/

# Runtime working directories (created by the worker at runtime)
work/

# Local input/output folders - keep the folders, ignore their contents
input/*
!input/.gitkeep
output/*
!output/.gitkeep
*.zip

# Auto-downloaded model weights (fetched on first run via modules/utils/download.py)
models/
*.onnx
*.pt
*.pth
*.safetensors

# OS / editor noise
.DS_Store
Thumbs.db

# More env variants (keep the template)
.env.*
!.env.example

# Logs
*.log
logs/

# Model weights and caches (ModelDownloader stores them in
# %LOCALAPPDATA%/MangaTranslationWorker/models, outside the repo)
*.gguf
*.ckpt
*.bin

# Experiment / test output (harnesses in scripts/ write here)
render_test/
output_*/
chapter_test/
flux_experiment/
cleaning_fix/

# Third-party comic fonts in FONT KLASÖR/ have no licence files, so they are
# not redistributed. Place your own fonts there locally (see README, "Placing fonts").
FONT KLASÖR/

# IDE
.vscode/
.idea/
*.swp
