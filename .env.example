# =============================================================================
# manga-translation worker — environment configuration
# Copy this file to .env and fill in the values for your deployment.
# Every value below is optional unless marked (required); defaults shown
# are what the code falls back to when a variable is unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required) — used by worker.py to poll the pipeline_jobs queue
# and write back chapter_assets / ChapterPage rows, and by the translator to
# log OpenAI usage events.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/dbname

# -----------------------------------------------------------------------------
# Storage backend — choose where raw/translated images are read from and
# written to. STORAGE_BACKEND=r2 (default) uses Cloudflare R2 (or any
# S3-compatible bucket); STORAGE_BACKEND=local uses plain disk, useful for
# running the pipeline fully offline / on a single machine.
# -----------------------------------------------------------------------------
STORAGE_BACKEND=r2

# Used only when STORAGE_BACKEND=local — root directory that raw/translated
# prefixes are resolved against.
LOCAL_STORAGE_ROOT=./storage

# Used only when STORAGE_BACKEND=r2
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL the bucket is served from (used to build the URLs stored
# in the database for translated images).
R2_PUBLIC_BASE_URL=

# Prefixes (folders) inside the bucket/local root that raw and translated
# chapter images live under.
R2_RAW_PREFIX=raw
R2_TRANSLATED_PREFIX=translated

# Delete the raw chapter images after a successful translation, and whether
# to keep the temporary working directory used during a batch run.
R2_DELETE_RAW_AFTER_TRANSLATE=true
R2_WORKDIR=work/r2
R2_KEEP_WORKDIR=false

# -----------------------------------------------------------------------------
# Branding / SEO — fully configurable so the same code can be deployed for
# any site, in any language, without touching a single line of code.
# -----------------------------------------------------------------------------
# Used to build the alt/title text written to the database for each page.
# Placeholders available: {site_name} {language_phrase} {slug} {number} {page}
SEO_TITLE_TEMPLATE={site_name} {language_phrase} {slug} bölüm {number} sayfa {page}
SEO_SITE_NAME=TrendManga
SEO_LANGUAGE_PHRASE=Türkçe manga oku

# Used to build the uploaded image filename.
# Placeholders available: {brand} {language_slug} {series} {chapter} {page} {ext}
SEO_FILENAME_TEMPLATE={brand}-{language_slug}-{series}-{chapter}-sayfa-{page}{ext}
SEO_IMAGE_BRAND=trendmanga
SEO_FILENAME_LANGUAGE_SLUG=turkce-manga-oku

# -----------------------------------------------------------------------------
# Translation languages
# -----------------------------------------------------------------------------
SOURCE_LANG=English
TARGET_LANG=Turkish

# -----------------------------------------------------------------------------
# Pipeline engine selection
# -----------------------------------------------------------------------------
DETECTOR=RT-DETR-v4-s-int8
OCR=9Router Vision Grid OCR
TRANSLATOR=GPT-5.4-mini

# -----------------------------------------------------------------------------
# Text cleaning (inpainting) — pixel-level recipe:
#   YOLOv8 comic-text-segmenter -> bubble-interior Otsu -> block-aware LaMa.
# The segmenter model downloads automatically on first use. Tune only if you
# see residual text (raise dilation) or over-erasing (lower it).
# -----------------------------------------------------------------------------
# Segmenter confidence threshold (lower = catches more faint/small text).
SEG_CONF=0.25
# Mask post-processing kernels (pixels): CLOSE bridges gaps between letters/
# lines, DILATE grows the final mask so anti-aliased edges are covered too.
MASK_CLOSE=13
MASK_DILATE=13

# -----------------------------------------------------------------------------
# Scanlation/fansub ad removal — the translator (GPT) flags blocks that are a
# competing group's promo (site links, Discord invites, "read at X.com",
# "premium chapters", QR prompts, watermark site names) instead of story text.
# Your own brand (SEO_SITE_NAME) is never flagged.
# -----------------------------------------------------------------------------
# Drop whole pages that are nothing but an ad (Discord/QR/WARNING pages).
SKIP_FULL_AD_PAGES=true
# A flagged ad block is only erased if its area is at least this fraction of
# the page — so big in-page ads get removed but tiny corner watermarks are
# left alone. Raise to keep more, lower to erase smaller ads.
AD_MIN_AREA_RATIO=0.015

# GPT-Vision ad-region detection — catches image-heavy promos (QR codes, cover
# collages, decorative "read at X.com" art) that detection/OCR miss entirely.
# For each scanned page vision reports how much of the top and bottom is ad, and
# that region is cropped off; pages that are entirely ad are dropped. Real comic
# art in the middle is always kept. Only the first/last few pages are scanned
# (ads almost always sit there), so cost stays ~$0.002 per chapter. Needs
# OPENAI_API_KEY.
AD_VISION_ENABLED=true
# How many pages from the start AND from the end to scan with vision.
AD_VISION_EDGE_PAGES=3

# Required only when OCR is set to a Qwen/DashScope engine - get a key
# from https://dashscope.console.aliyun.com/. Not needed if you switch OCR
# to a non-Qwen engine.
DASHSCOPE_API_KEY=

# Used by GPT translation and 9Router Vision Grid OCR.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint. Leave empty for OpenAI; use a local
# gateway URL (for example http://127.0.0.1:20128/v1) to route through 9Router.
# In Docker Desktop, the host may be reachable as http://host.docker.internal:20128/v1.
OPENAI_BASE_URL=
# Model ID sent to the configured OpenAI-compatible endpoint. For 9Router's
# Codex connection, for example: cx/gpt-6-luna. Overrides the UI model choice.
OPENAI_MODEL=gpt-5.4-mini
# Set to subscription when routing through a ChatGPT/Codex plan so usage logs
# record tokens without presenting API token-price estimates as a real bill.
OPENAI_USAGE_BILLING_MODE=api
# Optional fixed pricing overrides (USD per 1M tokens); otherwise inferred
# from the model name.
OPENAI_INPUT_PRICE_PER_1M=
OPENAI_OUTPUT_PRICE_PER_1M=
OPENAI_CACHED_INPUT_PRICE_PER_1M=
LOG_OPENAI_USAGE=true
OPENAI_USAGE_SOURCE=manga-translation-worker
OPENAI_USAGE_OPERATION=translation
OPENAI_USAGE_DEBUG=false

# GPU: auto (default) = use the NVIDIA GPU when CUDA is available, else CPU. true = force
# on (still falls back to CPU if CUDA is missing), false = CPU only (also keeps the cleaning
# stage on CPU). CLI: --gpu / --no-gpu. Controls the RT-DETR detector; the YOLO segmenter and
# LaMa follow SEG_DEVICE / LAMA_DEVICE (auto|cuda|cpu, default auto).
USE_GPU=auto
# TensorRT provider for onnxruntime is off (it needs nvinfer DLLs and only prints load errors
# before falling back to CUDA). Set true only if TensorRT is installed.
USE_TENSORRT=false

# -----------------------------------------------------------------------------
# Font / rendering
# -----------------------------------------------------------------------------
FONT_FAMILY=Arial
# Path to a .ttf/.otf file to register and use for rendering. Strongly
# recommended: headless/offscreen Qt has no real system font fallback, so
# leaving this empty produces missing-glyph boxes for non-ASCII text (e.g.
# Turkish). A font is bundled at assets/Comic Geek.ttf for convenience —
# swap in your own .ttf/.otf to change the look, or point FONT_FAMILY at an
# installed system font instead and clear this value.
FONT_FILE=assets/Comic Geek.ttf
MIN_FONT_SIZE=14
MAX_FONT_SIZE=58
UPPERCASE=true
NO_OUTLINE=false

# Optional repeating watermark/stamp overlay, applied every STAMP_EVERY_PAGES
# pages. assets/brand-stamp.png is a sample brand stamp - replace it (or
# point STAMP_PATH elsewhere) with your own, or set STAMP_ENABLED=false to
# disable it entirely.
STAMP_ENABLED=true
STAMP_PATH=assets/brand-stamp.png
STAMP_EVERY_PAGES=5
STAMP_OPACITY=1.0
STAMP_WIDTH_RATIO=0.2
STAMP_BLACK_BACKGROUND=false

# -----------------------------------------------------------------------------
# Output
# -----------------------------------------------------------------------------
# OUTPUT_SUFFIX may be empty (OUTPUT_SUFFIX= or CLI --suffix=) for files named exactly like the input.
OUTPUT_SUFFIX=_translated
OUTPUT_FORMAT=webp
# WEBP/JPEG quality (1-100) of every page written, including passthrough and stamped pages.
IMAGE_QUALITY=95
WEBP_MAX_DIMENSION=16000
# Zip the output/ folder into output.zip after a local (non-R2) run
# finishes - convenient for grabbing/sharing a single file.
ZIP_OUTPUT=false

# -----------------------------------------------------------------------------
# Batch / worker behavior
# -----------------------------------------------------------------------------
WORKER_IDLE_SECONDS=15
# If set, the worker runs this shell command once on startup instead of
# polling the job queue (useful for one-off maintenance commands in the
# same container image).
WORKER_STARTUP_COMMAND=
BATCH_TRANSLATE_SIZE=400
# Thread-pool size for the detect+OCR and clean phases. BATCH_WORKERS_AUTO=true (default) lets it
# go +1 when the CPU is idle (<35%) and -1 when busy (>80%), capped at BATCH_WORKERS_MAX
# (default 4; LaMa/YOLO calls on the GPU are serialised anyway, so more rarely helps).
# BATCH_WORKERS_AUTO=false uses BATCH_WORKERS exactly.
BATCH_WORKERS=3
BATCH_WORKERS_AUTO=true
BATCH_WORKERS_MAX=4
# Parallel GPT translate calls (each covers ~3 pages). Measured on a 73-page chapter: phase 2
# 77 s sequential -> 37 s with 3 -> 26 s with 4. 1 = sequential.
BATCH_TRANSLATE_CONCURRENCY=3
# While the gateway circuit breaker is open (3 consecutive 5xx/timeouts) only 1 translate call runs at a time.
# Measured on a healthy gateway: 4 -> 26 s, 3 -> 37 s for a 73-page chapter; 3 is gentler on a ChatGPT/Codex plan.

# --- Gateway resilience (9router / OpenAI-compatible endpoint), shared by OCR, translate and vision calls ---
# Transient failures (HTTP 5xx/429, timeout, broken stream) are retried with backoff + jitter.
GATEWAY_BACKOFFS=3,8,20
# After GATEWAY_BREAKER_THRESHOLD consecutive failures every call waits a cool-down (20 s, doubling to 60 s).
GATEWAY_BREAKER_THRESHOLD=3
GATEWAY_BREAKER_COOLDOWN=20
GATEWAY_BREAKER_COOLDOWN_MAX=60
# Max OCR requests in flight process-wide (independent of BATCH_WORKERS).
OCR_CONCURRENCY=2
# Pages whose OCR failed are re-run one at a time after this cool-down (seconds).
OCR_RERUN_COOLDOWN_SECONDS=30
# Fraction of pages allowed to fail OCR / translation before the job FAILS (exit 3, nothing published,
# raw pages kept, job re-queued). 0.0 = any failure fails the job. Raw pages are never deleted if any page failed.
OCR_MAX_FAIL_RATIO=0.0
# Pages where the detector found text bubbles but OCR returned nothing (published as untranslated "passthrough")
# above this fraction (and at least PASSTHROUGH_SUSPECT_MIN_PAGES pages) fail the job as a suspected gateway outage.
PASSTHROUGH_SUSPECT_RATIO=0.5
PASSTHROUGH_SUSPECT_MIN_PAGES=3

# Competitor scanlation watermarks/banners (VORTEXSCANS.COM, ...): clean = erase the WHOLE banner (default),
# keep = leave untouched. The site's own brand (SEO_SITE_NAME / TrendManga) is never touched.
WATERMARK_POLICY=clean
PAGE_MAX_RETRIES=3
BATCH_PIPELINE=true
RENDER_V2=true
RENDER_STYLE_TAGS=true
# Balloon-level layout (blocks that share one balloon): one font + one size band (+-RENDER_BALLOON_BAND of the median
# unless the source cap-height ratio exceeds RENDER_EMPHASIS_RATIO), every line inside the balloon interior,
# a continued sentence split over several blocks laid out as ONE paragraph, overlapping text boxes pulled apart.
# false = old per-block behaviour for that switch.
RENDER_BALLOON_UNIFY=true
RENDER_MERGE_BALLOON=true
RENDER_RESOLVE_OVERLAP=true
# Duplicate / stray / narration clean-up (see modules/utils/block_cleanup.py + balloon_layout.py):
#  RENDER_DEDUPE_TRANSLATIONS: a block whose translation repeats a longer neighbour's (same balloon / overlapping) is dropped
#  RENDER_GROUP_ROBUST: tolerant balloon grouping (mutual centre containment, text boxes lying inside each other)
#  RENDER_ABSORB_STRAYS: a tiny 1-2 word block inside a balloon joins the balloon's main text
#  RENDER_MERGE_NARRATION: stacked narration/caption lines of one box are laid out as ONE paragraph
#  RENDER_HARD_GUARD: every balloon block keeps all its line boxes (+2% clearance) inside the interior mask
RENDER_DEDUPE_TRANSLATIONS=true
RENDER_GROUP_ROBUST=true
RENDER_ABSORB_STRAYS=true
RENDER_MERGE_NARRATION=true
RENDER_HARD_GUARD=true
# Dense panel / UI text and OCR echoes (modules/rendering/render_v2.py):
#  RENDER_MERGE_OCR_ECHO: stacked OCR windows whose texts overlap at the seam become ONE paragraph (repeated words dropped)
#  RENDER_STRIP_NEIGHBOR_LINES: a split piece that repeats a neighbouring block's whole translation (title detected twice) is dropped
#  RENDER_STRICT_FIT: crowded sign/phone/narration blocks (touching a neighbour, or cut from a merged OCR block) stay inside
#    their OWN original box (shrink only, no growth, never pushed); below RENDER_STRICT_FLOOR px they fall back to normal fit
#  RENDER_TILT_FALLBACK: when the cleaned-page mask gives no tilt, read it from the original ink (diagonal text stays diagonal)
#  RENDER_TINY_PX: balloon text that ends below this size (at 800 px width) retries on its original text box (0 disables)
RENDER_MERGE_OCR_ECHO=true
RENDER_STRIP_NEIGHBOR_LINES=true
RENDER_STRICT_FIT=true
RENDER_STRICT_FLOOR=14
RENDER_TILT_FALLBACK=true
RENDER_TINY_PX=14
#  RENDER_SPIKY_GUARD: a spiky / non-convex balloon interior is trusted for the hard line-inside check (never shrunk below 70 percent)
RENDER_SPIKY_GUARD=true
RENDER_BALLOON_BAND=0.12
RENDER_EMPHASIS_RATIO=1.4

# Optional: dump raw per-call token usage to a file for cost debugging
# (see "Speed & cost" in the README). QWEN_GRID_OCR_USAGE_PATH writes a
# JSON summary of every OCR call; BATCH_TRANSLATE_USAGE_PATH appends one
# JSON line per batch-translate GPT call. Leave empty to disable both.
QWEN_GRID_OCR_USAGE_PATH=
BATCH_TRANSLATE_USAGE_PATH=

# Optional: ping a web app to invalidate its cache after a chapter is
# translated. Leave empty to disable.
WEB_INTERNAL_URL=
INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# Translation quality score (optional, costs extra OpenAI calls)
# -----------------------------------------------------------------------------
TRANSLATION_QUALITY_SCORE=false
QUALITY_SCORE_SAMPLE=20

# -----------------------------------------------------------------------------
# OCR cleanup / text-detection heuristics — sensible defaults for manga;
# tune only if you see specific artifacts in your output.
# -----------------------------------------------------------------------------
DROP_NON_ENGLISH_OCR_BLOCKS=true
NON_ENGLISH_MIN_LATIN_RATIO=0.35
DROP_DENSE_BACKGROUND_TEXT=true
DENSE_TEXT_MIN_CHARS=120
DENSE_TEXT_MIN_DENSITY=0.0022
PRUNE_OCR_BLOCKS=true
DROP_EMPTY_OCR_BLOCKS=true
OCR_DUPLICATE_OVERLAP=0.92
# Before translation: a block lying >= BLOCK_CONTAINMENT_RATIO inside another block whose words (>= BLOCK_TEXT_COVER) the
# other already has is the same text read twice at different scales -> dropped (BLOCK_CONTAINMENT_PRUNE=false disables)
BLOCK_CONTAINMENT_PRUNE=true
BLOCK_CONTAINMENT_RATIO=0.6
BLOCK_TEXT_COVER=0.8
SKIP_NOISY_OCR=true
STRIP_TRANSLATION_GARBAGE_LETTERS=true
TRANSLATION_GARBAGE_LETTERS=T L Y H I E LL
# true: per-page block dump in the log ('--- DEBUG BLOCKS after-clean-translate ---', lines carry '| page=.. bubble_xyxy=[..]
# style=..' after the classic fields) plus '--- DEBUG ITEMS render ---' (final font sizes). Replay a finished job offline,
# with zero API calls, using R2_KEEP_WORKDIR=true + scripts/replay_chapter.py (parse / styles / run / montage).
DEBUG_TRANSLATION_BLOCKS=false
RESTORE_UNTRANSLATED_REGIONS=true
EXTRA_CONTEXT=

GPT_OCR_EMPTY_BUBBLES=false
GPT_OCR_EMPTY_MAX=10
GPT_OCR_EMPTY_PAD=28

HD_STRATEGY=Resize
RESIZE_LIMIT=960

# -----------------------------------------------------------------------------
# Bubble cleaning / inpainting heuristics — defaults tuned for typical manga
# speech bubbles, override only if your source material is unusual.
# -----------------------------------------------------------------------------
CLEAN_WHITE_BUBBLES=true
BUBBLE_CLEAN_PAD=36
BUBBLE_EDGE_GUARD=10
BUBBLE_CLEAN_MIN_LUMA=185
BUBBLE_CLEAN_MAX_CHROMA=42
BUBBLE_TEXT_MAX_LUMA=238
BUBBLE_TEXT_MAX_CHROMA=110
BUBBLE_CLEAN_FILL_REGION=mask
BUBBLE_CLEAN_FILL_DELTA=8
BUBBLE_CLEAN_GHOST_DELTA=4

PROTECT_BUBBLE_OUTLINES=true
BUBBLE_OUTLINE_EDGE_MARGIN=34
BUBBLE_OUTLINE_MAX_LUMA=135
BUBBLE_OUTLINE_MAX_CHROMA=120
BUBBLE_OUTLINE_MIN_AREA=8
BUBBLE_OUTLINE_TEXT_GUARD=10
BUBBLE_OUTLINE_TEXT_OVERLAP_LIMIT=0.35
BUBBLE_OUTLINE_PROTECT_LONG_CURVES=false
BUBBLE_OUTLINE_EDGE_MIN_EXTENT=28
BUBBLE_OUTLINE_EDGE_MIN_AREA=22
BUBBLE_OUTLINE_MAX_FILL_RATIO=0.42

PROTECT_TEXT_CLEAR_PAD_X=48
PROTECT_TEXT_CLEAR_PAD_Y=24

CROP_CLEAN_DARK_MAX=125
CROP_CLEAN_WHITE_MIN=178
CROP_CLEAN_WHITE_SAT_MAX=105
CROP_CLEAN_DILATE=1
CROP_CLEAN_FEATHER=9

PANEL_SKIP_WHITE_RATIO=0.42
PANEL_SKIP_SAMPLE_PAD=28
PANEL_SKIP_MAX_STD=34

FILL_LIGHT_TEXT_REGIONS=true
LIGHT_FILL_PAD=10
LIGHT_FILL_WHITE_RATIO=0.45
LIGHT_FILL_FULL_RECT_WHITE_RATIO=0.62
LIGHT_FILL_FREE_TEXT_EXTRA_PAD=28
LIGHT_FILL_GRAY_MIN=180
LIGHT_FILL_SAT_MAX=90
LIGHT_FILL_MASK_DILATE=7

CLEAR_LIGHT_RENDER_REGIONS=true
LIGHT_RENDER_CLEAR_PAD_X=16
LIGHT_RENDER_CLEAR_PAD_Y=10
LIGHT_RENDER_CLEAR_WHITE_RATIO=0.52
LIGHT_RENDER_CLEAR_BAND_WHITE_RATIO=0.70
LIGHT_RENDER_CLEAR_GRAY_MIN=180
LIGHT_RENDER_CLEAR_SAT_MAX=100
# Free-text white wipe repaints with the LOCAL backdrop colour (Gaussian-normalised ring of the light pixels, follows
# gradients), skips non-plain zones (std of light pixels above MAX_STD) and never paints over thin long lines / big dark
# areas (panel and UI borders, artwork). LOCAL_BG=false restores the old single-median rectangle fill.
LIGHT_RENDER_CLEAR_LOCAL_BG=true
LIGHT_RENDER_CLEAR_MAX_STD=22
LIGHT_RENDER_CLEAR_BG_SIGMA=18

CLEAR_LIGHT_BUBBLE_RENDER_REGIONS=false
LIGHT_BUBBLE_RENDER_CLEAR_PAD_X=42
LIGHT_BUBBLE_RENDER_CLEAR_PAD_Y=24
LIGHT_BUBBLE_RENDER_CLEAR_WHITE_RATIO=0.55
LIGHT_BUBBLE_RENDER_CLEAR_GRAY_MIN=176
LIGHT_BUBBLE_RENDER_CLEAR_SAT_MAX=110
LIGHT_BUBBLE_RENDER_EDGE_GUARD=18
LIGHT_BUBBLE_RENDER_DARK_MAX=150
LIGHT_BUBBLE_RENDER_STROKE_GRAY_MIN=205
LIGHT_BUBBLE_RENDER_STROKE_SAT_MAX=85
LIGHT_BUBBLE_RENDER_MASK_DILATE=5
LIGHT_BUBBLE_RENDER_FULL_RECT_WHITE_RATIO=1.01
LIGHT_BUBBLE_RENDER_CLAMP_TO_BUBBLE=false

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Override the OS cache/data directory name used for downloaded model
# weights and logs (defaults to "MangaTranslationWorker").
DATA_DIR_NAME=MangaTranslationWorker

# CLI-only override: an explicit R2/local prefix pair for scripts/local_batch.py
# when invoked manually outside of the worker queue.
R2_INPUT_PREFIX=
R2_OUTPUT_PREFIX=

# Lossless pre-OCR recut: protect text and speech balloons across source seams.
# Safe pieces are translated/published as the new chapter pages. Default: enabled.
WEBTOON_SAFE_RECUT=true
RECUT_TARGET_HEIGHT=2000
# If no safe gap exists before this hard limit, fail and keep RAW images.
RECUT_MAX_HEIGHT=8000

# --- Cleaning QA (modules/inpainting/fill_qa.py, residual.py) -- all default ON ---
# Bad LaMa fills (blue "static", pink/green speckle, grey stipple on white) are measured against a ring of untouched
# pixels and replaced per component by a calmer fill (plane / Telea / NS / LaMa low-pass + grain + seamless border).
CLEAN_FILL_QA=true
CLEAN_FILL_QA_NOISE=2.5
CLEAN_FILL_QA_NOISE_ABS=3.5
CLEAN_FILL_QA_CHROMA=3.0
CLEAN_FILL_QA_CHROMA_ABS=2.0
CLEAN_FILL_QA_BLOBS=10
CLEAN_FILL_QA_BLOB_RATIO=4
CLEAN_FILL_QA_MIN_AREA=1200
CLEAN_FILL_QA_RING=40
# Residual pass: segment the cleaned page again and clean text-like leftovers near cleaned blocks (max 2 rounds).
CLEAN_RESIDUAL_PASS=true
CLEAN_RESIDUAL_PASSES=2
CLEAN_RESIDUAL_NEAR=150
CLEAN_RESIDUAL_CONF=0.1
CLEAN_RESIDUAL_MAX_FRAC=0.25
CLEAN_RESIDUAL_MIN_CONTRAST=28
CLEAN_RESIDUAL_GROW=5
